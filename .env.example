# ===== App =====
RAGI_DEBUG=false
RAGI_APP_PORT=8000
RAGI_APP_NAME=Ragi_AI

# ===== Database =====
RAGI_DB_HOST=postgres
RAGI_DB_PORT=5432
RAGI_DB_NAME=ragi
RAGI_DB_USER=ragi
RAGI_DB_PASSWORD=ragi
# true — создаст таблицы при старте (для dev). В проде — схема создаётся
# внешним инструментом (Alembic / SQL-скрипт), оставьте false.
RAGI_AUTO_CREATE_SCHEMA=false

# ===== Auth =====
RAGI_SECRET_KEY=change-me-to-a-long-random-string
RAGI_TOKEN_EXPIRE_MINUTES=30
RAGI_TOKEN_EXPIRE_DAYS=7

# ===== vLLM =====
RAGI_VLLM_BASE_URL=http://vllm:8000/v1
RAGI_VLLM_API_KEY=EMPTY
RAGI_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
RAGI_VLLM_TEMPERATURE=0.7
RAGI_VLLM_MAX_TOKENS=2048

# ===== Embeddings / RAG =====
RAGI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAGI_EMBEDDING_DIM=1024
RAGI_RAG_SEARCH_LIMIT=5
RAGI_RAG_BATCH_SIZE=64
RAGI_RAG_CHUNK_SIZE=500
RAGI_RAG_CHUNK_OVERLAP=100

# ===== Default admin (создаётся при первом запуске) =====
RAGI_DEFAULT_ADMIN_LOGIN=admin
RAGI_DEFAULT_ADMIN_PASSWORD=admin
RAGI_DEFAULT_ADMIN_NAME=админ
RAGI_SYSTEM_LOGIN=system

# ===== AI prompts =====
RAGI_AI_NAME=Раги
RAGI_SYSTEM_PROMPT="Ты - {name}, твоя задача отвечать на вопросы используя информацию из базы, а если информации нет — генерировать ответ самостоятельно и добавлять 'Ответ сгенерирован самостоятельно'"
RAGI_USER_PROMPT="Контекст: {context}\nВопрос: {quest}"