# App
CONTURAI_DEBUG=true
CONTURAI_APP_PORT=8000
CONTURAI_APP_NAME=ConturAI

# Database
CONTURAI_DB_HOST=postgres
CONTURAI_DB_PORT=5432
CONTURAI_DB_NAME=conturai
CONTURAI_DB_USER=conturai
CONTURAI_DB_PASSWORD=conturai

# vLLM
CONTURAI_VLLM_BASE_URL=http://vllm:8000/v1
CONTURAI_VLLM_API_KEY=EMPTY
CONTURAI_VLLM_MODEL_NAME=local-model
CONTURAI_VLLM_TEMPERATURE=0.7
CONTURAI_VLLM_MAX_TOKENS=1024

# Embeddings
CONTURAI_EMBEDDING_MODEL_PATH=/models/multilingual-e5-large
CONTURAI_EMBEDDING_DIM=1024

# RAG
CONTURAI_RAG_SEARCH_LIMIT=5
CONTURAI_RAG_BATCH_SIZE=64
CONTURAI_RAG_CHUNK_SIZE=500
CONTURAI_RAG_CHUNK_OVERLAP=100

# Offline
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1#@