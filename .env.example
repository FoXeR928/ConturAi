# App
RAGI_DEBUG=true
RAGI_APP_PORT=8000
RAGI_APP_NAME=Ragi_AI

# Database
RAGI_DB_HOST=postgres
RAGI_DB_PORT=5432
RAGI_DB_NAME=ragi
RAGI_DB_USER=ragi
RAGI_DB_PASSWORD=ragi
RAGI_AUTO_CREATE_SCHEMA=true

# vLLM
RAGI_VLLM_BASE_URL=http://vllm:8000/v1
RAGI_VLLM_API_KEY=EMPTY
RAGI_VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RAGI_VLLM_TEMPERATURE=0.7
RAGI_VLLM_MAX_TOKENS=1024

# Embeddings / RAG
RAGI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAGI_EMBEDDING_DIM=1024
RAGI_RAG_SEARCH_LIMIT=5
RAGI_RAG_BATCH_SIZE=64
RAGI_RAG_CHUNK_SIZE=500
RAGI_RAG_CHUNK_OVERLAP=100

# AI prompts
RAGI_AI_NAME=Раги
RAGI_SYSTEM_PROMPT="Ты - {name}. Отвечай на вопросы, используя контекст из базы. Если данных нет — отвечай самостоятельно и добавляй 'Ответ сгенерирован самостоятельно'"
RAGI_USER_PROMPT="Контекст: {context}\nВопрос: {quest}"

# Токен HF (опционально, если модель закрытая)
# HF_TOKEN=