# App
APP_NAME=ConturAI
APP_PORT=8000
DEBUG=true

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=conturai
DB_USER=conturai_user
DB_PASSWORD=conturai

# Paths
DATA_DIR=/app/data
MODELS_DIR=/models

# Какие модели качать (repo_id:local_name,repo_id:local_name)
# Эти имена должны совпадать с путями в docker-compose (./models/...)
MODELS_TO_DOWNLOAD=intfloat/multilingual-e5-large:multilingual-e5-large,Qwen/Qwen2.5-0.5B-Instruct:Qwen2.5-0.5B-Instruct

# Embeddings
EMBEDDING_MODEL_PATH=/models/multilingual-e5-large
EMBEDDING_DIM=1024

# RAG
RAG_SEARCH_LIMIT=5
RAG_BATCH_SIZE=64
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# Pytorch index (CPU / CUDA / ROCm)
PYTORCH_INDEX=https://download.pytorch.org/whl/cpu

# Offline
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1