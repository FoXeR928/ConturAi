# --- App ---
APP_NAME=ConturAI
APP_PORT=8000
DEBUG=true

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=conturai
DB_USER=conturai_user
DB_PASSWORD=conturai

# --- Paths ---
DATA_DIR=/app/data
MODELS_DIR=/models

# --- Embeddings ---
EMBEDDING_MODEL_PATH=/models/multilingual-e5-large
EMBEDDING_DIM=1024

# --- RAG ---
RAG_SEARCH_LIMIT=5
RAG_BATCH_SIZE=64
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# --- Models to download ---
MODELS_TO_DOWNLOAD=intfloat/multilingual-e5-large:multilingual-e5-large,Qwen/Qwen2.5-0.5B-Instruct:Qwen2.5-0.5B-Instruct

# --- PyTorch index ---
PYTORCH_INDEX=https://download.pytorch.org/whl/cpu

# --- vLLM (переопределяется manage.py use-platform) ---
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL_PATH=/models/Qwen2.5-0.5B-Instruct
VLLM_SERVED_NAME=local-model
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=2048
VLLM_EXTRA_ARGS=
VLLM_CPU_KVCACHE_SPACE=
VLLM_GPU_DRIVER=none
VLLM_GPU_COUNT=0
VLLM_DEVICE_KFD=/dev/null:/dev/null
VLLM_DEVICE_DRI=/dev/null:/dev/null

# --- Memory limits ---
PG_MEM_LIMIT=1g
VLLM_MEM_LIMIT=6g
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m

# --- Offline ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1