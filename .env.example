# App
APP_NAME=ConturAI
APP_PORT=8000
DEBUG=true

# Database (локальный запуск)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conturai
DB_USER=conturai
DB_PASSWORD=conturai

# JWT
TOKEN_EXPIRE_MINUTES=30
TOKEN_EXPIRE_DAYS=7

# vLLM
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=local-model
VLLM_TEMPERATURE=0.7
VLLM_MAX_TOKENS=1024

# Paths (относительно папки, откуда запускаете)
DATA_DIR=./data
MODELS_DIR=./models
EMBEDDING_MODEL_PATH=./models/multilingual-e5-large
EMBEDDING_DIM=1024

# RAG
RAG_SEARCH_LIMIT=5
RAG_BATCH_SIZE=64
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# Offline
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1