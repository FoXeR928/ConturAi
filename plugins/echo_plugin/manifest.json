{
  "id": "echo_plugin",
  "name": "Echo",
  "description": "Демонстрационный плагин: возвращает переданное сообщение с префиксом.",
  "version": "1.1.0",
  "api_version": "1",
  "kind": "internal",
  "is_active": true,
  "streaming": true,
  "max_history_chars": 4000,
  "execution_timeout": 30,
  "max_concurrent": 4,
  "settings_schema": {
    "prefix": {
      "type": "text",
      "label": "Префикс",
      "description": "Строка, добавляемая перед ответом",
      "default": "Echo: ",
      "required": true
    },
    "repeat": {
      "type": "slider",
      "label": "Повторов",
      "description": "Сколько раз повторить ответ",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1
    },
    "style": {
      "type": "select",
      "label": "Стиль",
      "default": "plain",
      "options": [
        {"label": "Обычный", "value": "plain"},
        {"label": "Верхний регистр", "value": "upper"},
        {"label": "Нижний регистр", "value": "lower"}
      ]
    }
  }
}