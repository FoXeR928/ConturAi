# --- Общие настройки ---
APP_NAME=ConturAI
APP_PORT=8000
DEBUG=false

# --- База данных ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=conturai_db
DB_USER=conturai_user
DB_PASSWORD=CHANGE_ME

# --- Безопасность (JWT) ---
TOKEN_EXPIRE_MINUTES=30
TOKEN_EXPIRE_DAYS=7

# --- Пути ---
DATA_DIR=/app/data
PLUGINS_DIR=/app/plugins