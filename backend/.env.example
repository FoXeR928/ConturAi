# --- Локальный режим (backend на хосте) ---
APP_NAME=conturai-backend
DEBUG=false
SECRET_KEY=dev-secret-change-me-please
TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Postgres из docker-compose.dev.yml (порт 5432 проброшен на хост)
DATABASE_URL=postgresql+asyncpg://conturai_user:conturai_secret_change_me@localhost:5432/conturai_db

PLUGINS_DIR=./plugins
CONTURAI_MANAGER_URL=http://127.0.0.1:8080
PLUGIN_ENDPOINT_MODE=local
CORS_ORIGINS=*