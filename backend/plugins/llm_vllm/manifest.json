{
  "id": "llm_vllm",
  "name": "vLLM (LLM-генератор)",
  "description": "Финальный плагин пайплайна: генерация ответа через vLLM",
  "version": "1.0.0",
  "api_version": "1",
  "kind": "internal",
  "is_active": true,
  "priority": 100,
  "provides_stream": true,
  "execution_timeout": 180,
  "max_concurrent": 2,
  "settings_schema": {
    "mode": {
      "type": "select",
      "label": "Режим работы",
      "default": "external",
      "options": [
        { "label": "External — подключиться к существующему", "value": "external" },
        { "label": "Managed — управлять Docker-контейнером", "value": "managed" }
      ]
    },
    "external_url": {
      "type": "text",
      "label": "URL vLLM (для External)",
      "default": "http://vllm:8000",
      "description": "Например, http://192.168.1.10:8000"
    },
    "model": {
      "type": "text",
      "label": "Модель",
      "default": "Qwen/Qwen2.5-1.5B-Instruct",
      "description": "Для Managed — id модели на HuggingFace; для External — served-model-name"
    },
    "served_model_name": {
      "type": "text",
      "label": "served-model-name",
      "default": "local-model",
      "description": "Используется в запросах к /v1/chat/completions"
    },
    "temperature": {
      "type": "slider",
      "label": "Температура",
      "default": 0.7,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    "max_tokens": {
      "type": "number",
      "label": "Максимум токенов",
      "default": 1024,
      "min": 1,
      "max": 8192
    },
    "max_model_len": {
      "type": "number",
      "label": "Контекст модели (Managed)",
      "default": 2048,
      "min": 512,
      "max": 32768
    },
    "image": {
      "type": "text",
      "label": "Docker-образ (Managed)",
      "default": "vllm/vllm-openai:latest"
    },
    "container_name": {
      "type": "text",
      "label": "Имя контейнера (Managed)",
      "default": "conturai_plugin_vllm"
    },
    "host_port": {
      "type": "number",
      "label": "Порт на хосте (Managed)",
      "default": 8000,
      "min": 1024,
      "max": 65535
    },
    "gpu_enabled": {
      "type": "boolean",
      "label": "Использовать GPU (Managed)",
      "default": true
    },
    "hf_token": {
      "type": "text",
      "label": "HuggingFace токен (опционально)",
      "default": ""
    }
  },
  "actions": [
    {
      "id": "restart",
      "label": "Перезапустить контейнер",
      "confirm": true,
      "description": "Принудительно пересоздать контейнер vLLM"
    },
    {
      "id": "stop",
      "label": "Остановить контейнер",
      "confirm": true
    },
    {
      "id": "logs",
      "label": "Логи (в ответе)",
      "confirm": false
    }
  ]
}