name: conturai

services:
  postgres:
    image: pgvector/pgvector:pg16
    container_name: conturai_postgres
    environment:
      POSTGRES_USER: ${DB_USER:-conturai}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-conturai}
      POSTGRES_DB: ${DB_NAME:-conturai}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      # Проверяем, что база готова
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
    restart: unless-stopped

  # Опционально: если нужен vLLM (без него AI не будет отвечать)
  # vllm:
  #   image: vllm/vllm-openai:latest
  #   ...

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: conturai_backend
    env_file: .env
    environment:
      # Переопределяем host, так как внутри docker-сети база называется "postgres"
      DB_HOST: postgres
      DATA_DIR: /app/data
    ports:
      - "8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - app_data:/app/data
      - ./models:/models:ro
    restart: unless-stopped

volumes:
  pgdata:
  app_data: